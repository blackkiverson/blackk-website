---
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  label?: string;
  ratio?: string;
  loading?: 'lazy' | 'eager';
  /** 'contain' suits phone screenshots, which should not be cropped. */
  fit?: 'cover' | 'contain';
}
const {
  src,
  alt,
  label = 'Screenshot to come',
  ratio = '16 / 10',
  loading = 'lazy',
  fit = 'cover',
} = Astro.props;

const url = resolveImage(src);
---
{url ? (
  <img
    src={url}
    alt={alt}
    loading={loading}
    decoding="async"
    style={`aspect-ratio:${ratio};object-fit:${fit}`}
    class="cover-img"
  />
) : (
  <div class="placeholder" style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
    <span>{label}</span>
  </div>
)}

<style>
  .cover-img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    background: var(--paper-2);
  }
</style>
