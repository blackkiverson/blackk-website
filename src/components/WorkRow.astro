---
import type { Project } from '../data/work';
import Cover from './Cover.astro';
import Arrow from './Arrow.astro';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const shown = p.evidence.slice(0, 3);
const flip = index % 2 === 1;
---
<article class={`card card--${p.tint} ${flip ? 'card--flip' : ''}`}>
  <a class="card__hit" href={`/work/${p.slug}`}>
    <span class="sr-only">Read the {p.name} case study</span>
  </a>

  <div class="card__body">
    <p class="card__brand">
      <span class="card__name">{p.name}</span>
      <span class="card__meta">
        {p.role}{p.status ? ` · ${p.status}` : ''}
      </span>
    </p>

    <div class="card__main">
      <p class="eyebrow card__kicker">{p.kicker}</p>

      <h3 class="h3 card__title">{p.headline}</h3>

      <div class="card__reveal">
        <p class="card__summary">{p.blurb}</p>
      </div>

      {shown.length > 0 && (
        <dl class="stats">
          {shown.map((e) => (
            <div class="stat">
              <dt class="stat__label">{e.label}</dt>
              <dd class="stat__value">{e.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <p class="btn card__cta" aria-hidden="true">View case study<Arrow /></p>
    </div>
  </div>

  <div class="card__media">
    <Cover src={p.cover} alt={p.coverAlt} ratio="4 / 3" />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    padding: var(--card-pad);
    border-radius: var(--r-xl);
    background: var(--tint);
    box-shadow: var(--shadow-card);
    transition: transform var(--dur-slow) var(--ease),
                box-shadow var(--dur-slow) var(--ease);
  }
  .card + .card { margin-top: var(--card-gap); }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }

  .card--pink     { --tint: var(--tint-pink);     --tint-ink: var(--tint-ink-pink); }
  .card--mint     { --tint: var(--tint-mint);     --tint-ink: var(--tint-ink-mint); }
  .card--blue     { --tint: var(--tint-blue);     --tint-ink: var(--tint-ink-blue); }
  .card--lavender { --tint: var(--tint-lavender); --tint-ink: var(--tint-ink-lavender); }
  .card--rust     { --tint: var(--tint-rust);     --tint-ink: var(--tint-ink-rust); }

  @media (min-width: 52rem) {
    .card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: center;
    }
    /* Alternating the image side stops four stacked cards reading as a table. */
    .card--flip .card__media { order: -1; }
  }

  .card__hit { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }

  /* ---- Body ---- */
  .card__body { display: flex; flex-direction: column; }

  /* The reference leads with the product name, then leaves a deliberate gap
     before the rest of the block. */
  .card__brand { margin-bottom: clamp(var(--s-6), 5vw, var(--s-9)); }
  .card__name {
    display: block;
    font-size: var(--t-1);
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-tight);
    color: var(--ink);
  }
  .card__meta {
    display: block;
    margin-top: var(--s-1);
    font-size: var(--t--1);
    color: var(--ink-2);
  }

  .card__main > * + * { margin-top: var(--s-4); }

  .card__kicker { color: var(--ink); }

  /* Wide enough that the longest headline (59 characters) balances onto two
     lines rather than three. The body column is the real constraint above
     52rem; the cap only bites in a wider container. */
  .card__title {
    color: var(--ink);
    max-width: 30ch;
    transition: color var(--dur) var(--ease);
  }
  .card:hover .card__title { color: var(--tint-ink); }

  /* ---- Hover reveal ------------------------------------------------------
     The description collapses to nothing and expands on hover, which keeps the
     index scannable: name, eyebrow, headline, then the numbers.

     Three things stop this becoming an accessibility problem:
       - it only collapses where hover is a real input (`hover: hover` and
         `pointer: fine`), so touch devices always show the description;
       - `:focus-within` opens it for keyboard users tabbing the card link;
       - it collapses with height and opacity, never `display` or `visibility`,
         so the text stays in the accessibility tree and screen readers read it
         whether it is open or not.
     The 0fr -> 1fr grid trick animates an unknown height, so the copy is never
     truncated to a guessed pixel value.
     ------------------------------------------------------------------------ */
  .card__reveal {
    display: grid;
    grid-template-rows: 1fr;   /* the open, no-hover default */
    margin-top: 0;
    transition: grid-template-rows var(--dur-slow) var(--ease),
                opacity var(--dur-slow) var(--ease);
  }
  .card__reveal > * { overflow: hidden; }

  .card__summary {
    padding-top: var(--s-4);   /* inside the clip, so it collapses too */
    color: var(--ink-2);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  @supports (grid-template-rows: 0fr) {
    @media (hover: hover) and (pointer: fine) {
      .card__reveal { grid-template-rows: 0fr; opacity: 0; }
      .card:hover .card__reveal,
      .card:focus-within .card__reveal { grid-template-rows: 1fr; opacity: 1; }
    }
  }

  /* ---- Stats ---- */
  /* Two even columns rather than shrink-to-fit flex items, so every label
     gets the same half-column to wrap into. auto-fit drops to one column
     below roughly 26rem of body width, which is where two would crush. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--s-5) var(--s-6);
    margin: 0;
    padding-block: var(--s-2);
  }
  .stat { display: flex; flex-direction: column-reverse; gap: var(--s-1); }
  .stat__value {
    margin: 0;
    font-size: var(--t-3);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-tight);
    color: var(--tint-ink);
  }
  /* --ink-3 drops below 4.5:1 on the stronger tints, so labels use --ink-2. */
  .stat__label {
    font-size: var(--t--1);
    line-height: 1.3;
    color: var(--ink-2);
    /* Fills the grid cell, so the typical label runs to two lines. The cap is
       only a backstop for a single-column card. */
    max-width: 34ch;
  }

  .card__cta { margin-top: var(--s-6); align-self: flex-start; }
  .card:hover .card__cta { background: var(--tint-ink); }

  /* ---- Media ---- */
  .card__media { overflow: visible; }
  .card__media :global(img),
  .card__media :global(.placeholder) {
    border: 0;
    border-radius: var(--r-lg);
    transition: transform var(--dur-slow) var(--ease);
  }
  .card:hover .card__media :global(img) { transform: scale(1.02); }
</style>
